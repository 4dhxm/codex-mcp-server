{
  "name": "codex-mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for OpenAI Codex programmatic integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:sse": "node dist/index.js --sse",
    "dev": "tsx watch src/index.ts --http --tunnel"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@openai/codex-sdk": "^0.139.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.20",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
